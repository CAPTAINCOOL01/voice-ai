# ── Core ──
PORT=5000
MONGO_URI=
JWT_SECRET=

# ── Legacy bootstrap admin (auto-migrates to DB user on first login) ──
APP_USERNAME=
APP_PASSWORD=

# ── ESP32 device ──
ESP32_API_KEY=

# ── Cloudflare R2 ──
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Existing AI providers ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# ── NEW: Processing pipeline configuration ──
DEFAULT_PROCESSING_MODE=normal
LEGACY_INLINE_PROCESSING=false

# Normal (self-hosted)
NORMAL_ASR_PROVIDER=runpod
NORMAL_ASR_MODEL=large-v3-turbo
NORMAL_REPORT_PROVIDER=runpod
NORMAL_REPORT_MODEL=

# Premium (managed)
PREMIUM_STT_PROVIDER=sarvam
PREMIUM_STT_MODEL=saaras:v3
PREMIUM_STT_DIARIZATION=true
PREMIUM_REPORT_PROVIDER=anthropic
PREMIUM_REPORT_MODEL=claude-opus-4-7
PREMIUM_REPORT_FALLBACK_MODEL=claude-opus-4-6

# Control (existing pipeline, used for hidden benchmark)
CONTROL_STT_PROVIDER=sarvam
CONTROL_REPORT_PROVIDER=anthropic
CONTROL_REPORT_MODEL=claude-sonnet-4-6

# RunPod endpoints
RUNPOD_API_KEY=
ML_WORKER_WHISPER_ENDPOINT=
ML_WORKER_QWEN_ENDPOINT=
ML_WORKER_SHARED_SECRET=

# ── NEW: Billing ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── NEW: Trial ──
TRIAL_NORMAL_MINUTES=120
TRIAL_PREMIUM_MINUTES=60
TRIAL_VALIDITY_DAYS=14

# ── NEW: Cost + pricing assumptions (also stored in DB via seed) ──
NORMAL_COST_TARGET_INR_PER_HOUR=10
PREMIUM_COST_TARGET_INR_PER_HOUR=67
TARGET_CONTRIBUTION_MARGIN=0.25
PAYMENT_GATEWAY_RATE=0.02

# ── NEW: Admin bootstrap ──
ADMIN_USER_EMAILS=

# ── NEW: Benchmark ──
BENCHMARK_ENABLED_UNTIL_RECORDINGS=50

# ── NEW: PDF / visuals ──
PDF_STORAGE_PREFIX=reports/
